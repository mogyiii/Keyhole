<Project>

  <PropertyGroup>
    <!-- Windows-only by design: ETW, WFP, Windows Firewall COM and Npcap all are. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Globalization is on because the interface ships in English and Hungarian, and
         invariant mode makes every culture except the invariant one unavailable: even
         CultureInfo.GetCultureInfo("hu") throws. Windows' own NLS is used rather than
         ICU, which is both appropriate for a Windows-only tool and keeps ICU's data out
         of the two self-contained publishes. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- No SupportedOSPlatformVersion / windows10.0.x TFM on purpose: Keyhole reaches Windows
         through P/Invoke and COM, not WinRT, so the heavier projection TFM buys nothing. -->

    <Product>Keyhole</Product>
    <Company>Keyhole</Company>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use Windows' NLS for culture data instead of ICU. Windows-only already, and this
         is what lets globalization be on without ICU's data in the package. -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
