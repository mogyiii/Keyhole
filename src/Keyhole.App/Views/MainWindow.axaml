<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Keyhole.App.ViewModels"
        mc:Ignorable="d"
        x:Class="Keyhole.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Keyhole"
        Width="1100" Height="680"
        MinWidth="820" MinHeight="520"
        Background="#11131A">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#7D8694" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="Foreground" Value="#E6EAF0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#181B24" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#242935" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#20242F" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="Foreground" Value="#C3CAD5" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="20">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Keyhole" FontSize="22" FontWeight="Bold" Foreground="#E6EAF0" />
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#7D8694" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- Colour is backed by the adjacent text so it is never the only signal. -->
          <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                   Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
          <TextBlock Text="{Binding State}" Classes="heading" VerticalAlignment="Center" />
        </StackPanel>
        <Button Content="Block an app…" Command="{Binding BrowseAndBlockCommand}"
                IsEnabled="{Binding CanBlock}" Padding="14,6" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsBusy}" Padding="14,6" />
      </StackPanel>
    </Grid>

    <!-- Warning strips: explain missing capability instead of leaving it unexplained -->
    <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0">
      <Border Classes="card" Padding="14,10"
              Background="#2A2113" BorderBrush="#4A3A1B"
              IsVisible="{Binding ByteCountingWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="⚠" FontSize="14" Foreground="#D29922" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ByteCountingWarning}" TextWrapping="Wrap"
                     Foreground="#E3B341" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="14,10"
              Background="#2A2113" BorderBrush="#4A3A1B"
              IsVisible="{Binding BlockingWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="⚠" FontSize="14" Foreground="#D29922" VerticalAlignment="Center" />
          <TextBlock Text="{Binding BlockingWarning}" TextWrapping="Wrap"
                     Foreground="#E3B341" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- App list over connection drill-down -->
    <Grid Grid.Row="2" RowDefinitions="2*,Auto,3*" Margin="0,14,0,0">

      <Border Grid.Row="0" Classes="card">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
            <TextBlock Grid.Column="0" Text="Applications" Classes="heading" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Block selected"
                    Command="{Binding BlockSelectedCommand}"
                    IsEnabled="{Binding CanBlock}"
                    Padding="12,4" FontSize="12" />
          </Grid>


          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding Apps}"
                    SelectedItem="{Binding SelectedApp}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    HeadersVisibility="Column"
                    Margin="6,0,6,6">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="2*" />
              <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.4*" />
              <DataGridTextColumn Header="Signature" Binding="{Binding Signature}" Width="90" />
              <DataGridTextColumn Header="Active" Binding="{Binding ActiveConnections}" Width="70" />
              <DataGridTextColumn Header="Total" Binding="{Binding TotalConnections}" Width="70" />
              <DataGridTextColumn Header="Traffic" Binding="{Binding Traffic}" Width="150" />
              <DataGridTextColumn Header="Recent hosts" Binding="{Binding RemoteHosts}" Width="2.5*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1" Height="8" Background="Transparent"
                    HorizontalAlignment="Stretch" ResizeDirection="Rows" />

      <Border Grid.Row="2" Classes="card">
        <TabControl Margin="8,4,8,8">

          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Connections" />
                <TextBlock Text="{Binding SelectedApp.DisplayName}" Classes="label"
                           VerticalAlignment="Center" IsVisible="{Binding HasSelection}" />
              </StackPanel>
            </TabItem.Header>

            <Grid>
              <TextBlock Text="Select an application above to see its connections."
                         Classes="label" VerticalAlignment="Center" HorizontalAlignment="Center"
                         IsVisible="{Binding !HasSelection}" />

              <DataGrid ItemsSource="{Binding Flows}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        HeadersVisibility="Column"
                        IsVisible="{Binding HasSelection}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="70" />
                  <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                  <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="1.4*" />
                  <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="2.4*" />
                  <DataGridTextColumn Header="Port" Binding="{Binding RemotePort}" Width="70" />
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="1.2*" />
                  <DataGridTextColumn Header="Traffic" Binding="{Binding Traffic}" Width="150" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <TabItem Header="Blocked apps">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Text="{Binding LastActionMessage}" Classes="label"
                         Margin="8,4,8,8" TextWrapping="Wrap"
                         IsVisible="{Binding LastActionMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <TextBlock Grid.Row="1"
                         Text="Nothing is blocked. Use &quot;Block an app…&quot; or select an application above."
                         Classes="label" VerticalAlignment="Center" HorizontalAlignment="Center"
                         IsVisible="{Binding !Rules.Count}" />

              <DataGrid Grid.Row="1"
                        ItemsSource="{Binding Rules}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="1.4*" />
                  <DataGridTextColumn Header="Path" Binding="{Binding ExecutablePath}" Width="3*" />
                  <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="100" />
                  <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="140" />
                  <DataGridTextColumn Header="" Binding="{Binding ExecutableWarning}" Width="2*" />
                  <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Unblock" Padding="10,2" FontSize="11" Margin="4,2"
                                Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).UnblockCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

        </TabControl>
      </Border>
    </Grid>
  </Grid>
</Window>
