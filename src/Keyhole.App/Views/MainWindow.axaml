<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Keyhole.App.ViewModels"
        xmlns:controls="using:Keyhole.App.Controls"
        xmlns:l="using:Keyhole.App.Localization"
        mc:Ignorable="d"
        x:Class="Keyhole.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Keyhole"
        Width="1180" Height="800"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource WindowBackground}">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="20">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Keyhole" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- Colour is backed by the adjacent text so it is never the only signal. -->
          <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                   Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
          <TextBlock Text="{Binding State}" Classes="heading" VerticalAlignment="Center" />
        </StackPanel>
        <Button Content="{Binding LanguageLabel}" Command="{Binding CycleLanguageCommand}"
                Padding="12,6" ToolTip.Tip="{l:Translate SettingsLanguage}" />
        <Button Content="{Binding ThemeLabel}" Command="{Binding CycleThemeCommand}"
                Padding="12,6" ToolTip.Tip="Switch between auto, light and dark" />
        <Button Content="Block an app…" Command="{Binding BrowseAndBlockCommand}"
                IsEnabled="{Binding CanBlock}" Padding="14,6" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsBusy}" Padding="14,6" />
      </StackPanel>
    </Grid>

    <!-- One strip for everything unavailable: the causes are the same, and two boxes
         would repeat themselves while costing the list a third of its height. -->
    <Border Grid.Row="1" Classes="card" Padding="12,7" Margin="0,12,0,0"
            Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}"
            IsVisible="{Binding CapabilityWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="9">
        <TextBlock Text="⚠" FontSize="13" Foreground="{DynamicResource WarningIcon}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CapabilityWarning}" TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningText}" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Dashboard graph, app list, drill-down -->
    <!-- The app list is the primary view, so it gets the larger share. -->
    <Grid Grid.Row="2" RowDefinitions="Auto,3*,Auto,2*" Margin="0,12,0,0">

      <Border Grid.Row="0" Classes="card" Height="128" Margin="0,0,0,8">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,10,16,4">
            <TextBlock Grid.Column="0" Text="Throughput" Classes="heading" VerticalAlignment="Center" />

            <!-- Legend: two series must never be identified by colour alone. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                        Margin="18,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="10" Height="2" Fill="{DynamicResource SeriesUpload}" VerticalAlignment="Center" />
                <TextBlock Text="Upload" Classes="label" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="10" Height="2" Fill="{DynamicResource SeriesDownload}" VerticalAlignment="Center" />
                <TextBlock Text="Download" Classes="label" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding TotalRate}" Classes="heading"
                       VerticalAlignment="Center" />
          </Grid>

          <controls:ThroughputChart Grid.Row="1" Points="{Binding Throughput}" Margin="8,0,8,6"
                                    SentBrush="{DynamicResource SeriesUpload}"
                                    ReceivedBrush="{DynamicResource SeriesDownload}"
                                    GridBrush="{DynamicResource GridLine}"
                                    TextBrush="{DynamicResource TextMuted}" />
        </Grid>
      </Border>


      <Border Grid.Row="1" Classes="card">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,12,16,8">
            <TextBlock Grid.Column="0" Text="Applications" Classes="heading" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SearchText}"
                     PlaceholderText="Search apps, publishers, hosts…"
                     Margin="16,0" MaxWidth="320" HorizontalAlignment="Left"
                     FontSize="12" Padding="8,4" />
            <Button Grid.Column="2" Content="Block selected"
                    Command="{Binding BlockSelectedCommand}"
                    IsEnabled="{Binding CanBlock}"
                    Padding="12,4" FontSize="12" />
          </Grid>

          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding VisibleApps}"
                    SelectedItem="{Binding SelectedApp}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    HeadersVisibility="Column"
                    Margin="6,0,6,6">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="36">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Image Source="{Binding Icon}" Width="18" Height="18"
                           Margin="6,2" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="2*" />
              <!-- Blocked state is a word, not just a colour, so it survives CVD and greyscale. -->
              <DataGridTextColumn Header="" Binding="{Binding BlockedLabel}" Width="74" />
              <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.3*" />
              <DataGridTextColumn Header="Signature" Binding="{Binding Signature}" Width="100" />
              <DataGridTextColumn Header="Conns" Binding="{Binding ActiveConnections}" Width="75" />
              <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="165" />
              <DataGridTextColumn Header="Total" Binding="{Binding Traffic}" Width="150" />
              <DataGridTextColumn Header="Recent hosts" Binding="{Binding RemoteHosts}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="2" Height="8" Background="Transparent"
                    HorizontalAlignment="Stretch" ResizeDirection="Rows" />

      <Border Grid.Row="3" Classes="card">
        <TabControl Margin="8,4,8,8">

          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Connections" />
                <TextBlock Text="{Binding SelectedApp.DisplayName}" Classes="label"
                           VerticalAlignment="Center" IsVisible="{Binding HasSelection}" />
              </StackPanel>
            </TabItem.Header>

            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="1" Text="Select an application above to see its connections."
                         Classes="label" VerticalAlignment="Center" HorizontalAlignment="Center"
                         IsVisible="{Binding !HasSelection}" />

              <!-- The app's own throughput, on the same scale rules as the dashboard
                   graph: one axis, two series, both named in the legend above. -->
              <controls:ThroughputChart Grid.Row="0" Height="72" Margin="4,2,4,6"
                                        Points="{Binding AppThroughput}"
                                        IsVisible="{Binding HasSelection}"
                                        SentBrush="{DynamicResource SeriesUpload}"
                                        ReceivedBrush="{DynamicResource SeriesDownload}"
                                        GridBrush="{DynamicResource GridLine}"
                                        TextBrush="{DynamicResource TextMuted}" />

              <DataGrid Grid.Row="1"
                        ItemsSource="{Binding Flows}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        HeadersVisibility="Column"
                        IsVisible="{Binding HasSelection}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="70" />
                  <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                  <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="1.4*" />
                  <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="2.2*" />
                  <DataGridTextColumn Header="Port" Binding="{Binding RemotePort}" Width="70" />
                  <DataGridTemplateColumn Header="CC" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Country}" Margin="6,0" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding LocationDetail}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="1.4*" />
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="1.1*" />
                  <DataGridTextColumn Header="Traffic" Binding="{Binding Traffic}" Width="145" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <TabItem Header="Hosts">
            <Grid RowDefinitions="Auto,Auto,*">
              <!-- Sits here rather than above the app list: it affects two columns on this
                   tab and nothing else, so a permanent banner would be noise. -->
              <Border Grid.Row="0" Classes="card" Padding="12,7" Margin="8,6,8,2"
                      Background="{DynamicResource WarningBackground}"
                      BorderBrush="{DynamicResource WarningBorder}"
                      IsVisible="{Binding HasGeoIpWarning}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="⚠" FontSize="13" Foreground="{DynamicResource WarningIcon}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding GeoIpWarning}" TextWrapping="Wrap"
                             Foreground="{DynamicResource WarningText}" FontSize="12"
                             VerticalAlignment="Center" MaxWidth="900" />
                </StackPanel>
              </Border>

              <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,6,8,8">
                <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="430"
                           Text="Destinations ranked by traffic, across every application. The list above answers what one program is doing; this answers it from the other end — a host several unrelated programs all talk to is worth a look. Loopback is excluded." />
                <TextBox Grid.Column="1" Text="{Binding HostSearchText}"
                         PlaceholderText="Search hosts, apps, addresses, ports…"
                         Margin="16,0,0,0" MaxWidth="320" HorizontalAlignment="Left"
                         VerticalAlignment="Center" FontSize="12" Padding="8,4" />
              </Grid>

              <TextBlock Grid.Row="2" Text="No outbound destinations yet."
                         Classes="label" VerticalAlignment="Center" HorizontalAlignment="Center"
                         IsVisible="{Binding !VisibleHosts.Count}" />

              <DataGrid Grid.Row="2"
                        ItemsSource="{Binding VisibleHosts}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        HeadersVisibility="Column"
                        IsVisible="{Binding VisibleHosts.Count}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="2.2*" />
                  <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100" />
                  <DataGridTextColumn Header="Traffic" Binding="{Binding Traffic}" Width="165" />
                  <DataGridTextColumn Header="Conns" Binding="{Binding Connections}" Width="80" />
                  <!-- Country and operator hang off the GeoIP databases, so both stay
                       blank rather than showing a placeholder when none is installed. -->
                  <DataGridTemplateColumn Header="CC" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Country}" Margin="6,0" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding LocationDetail}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="1.5*" />
                  <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="105" />
                  <DataGridTextColumn Header="Applications" Binding="{Binding Applications}" Width="2*" />
                  <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <TabItem Header="Blocked apps">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Text="{Binding LastActionMessage}" Classes="label"
                         Margin="8,4,8,8" TextWrapping="Wrap"
                         IsVisible="{Binding LastActionMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <TextBlock Grid.Row="1"
                         Text="Nothing is blocked. Use &quot;Block an app…&quot; or select an application above."
                         Classes="label" VerticalAlignment="Center" HorizontalAlignment="Center"
                         IsVisible="{Binding !Rules.Count}" />

              <DataGrid Grid.Row="1"
                        ItemsSource="{Binding Rules}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="1.4*" />
                  <DataGridTextColumn Header="Path" Binding="{Binding ExecutablePath}" Width="3*" />
                  <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="100" />
                  <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="140" />
                  <DataGridTextColumn Header="" Binding="{Binding ExecutableWarning}" Width="2*" />
                  <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Unblock" Padding="10,2" FontSize="11" Margin="4,2"
                                Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).UnblockCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <TabItem Header="Capture">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
              <TextBlock Grid.Row="0" Margin="8,6,8,2" TextWrapping="Wrap" Classes="label"
                         Text="Keyhole launches the application with SSLKEYLOGFILE set for that process only, and records its packets alongside. The capture carries its own TLS keys, so Wireshark opens it decrypted with nothing to configure. Applications on Windows' own TLS stack write no keys and stay encrypted." />

              <!-- Npcap's absence belongs here rather than in the strip above the app
                   list: it affects captures only, and this is where the button that
                   fixes it can sit next to the explanation. -->
              <Border Grid.Row="1" Classes="card" Padding="12,7" Margin="8,6,8,2"
                      Background="{DynamicResource WarningBackground}"
                      BorderBrush="{DynamicResource WarningBorder}"
                      IsVisible="{Binding HasPacketCaptureWarning}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0" Text="⚠" FontSize="13" Margin="0,0,9,0"
                             Foreground="{DynamicResource WarningIcon}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding PacketCaptureWarning}" TextWrapping="Wrap"
                             Foreground="{DynamicResource WarningText}" FontSize="12"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="Get Npcap…" Padding="12,4" FontSize="12"
                          Margin="12,0,0,0"
                          IsVisible="{Binding CanInstallNpcap}"
                          IsEnabled="{Binding !IsInstallingNpcap}"
                          Command="{Binding InstallNpcapCommand}"
                          ToolTip.Tip="Downloads the installer from npcap.com and verifies its signature before running it. Keyhole does not redistribute Npcap." />
                </Grid>
              </Border>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="8,6,8,8">
                <Button Content="Launch app with key logging…"
                        Command="{Binding StartCaptureCommand}" Padding="14,6" FontSize="12" />
                <TextBlock Text="{Binding LastActionMessage}" Classes="label" TextWrapping="Wrap"
                           VerticalAlignment="Center" MaxWidth="620" />
              </StackPanel>

              <!-- Sessions above, the requests decoded out of one of them below. The
                   splitter lets either half take the space, because which one matters
                   depends entirely on what the user is doing. -->
              <Grid Grid.Row="3" RowDefinitions="*,Auto,Auto,1.3*">

                <TextBlock Grid.Row="0" Text="No captures yet." Classes="label"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsVisible="{Binding !Captures.Count}" />

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Captures}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          IsVisible="{Binding Captures.Count}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding DisplayName}" Width="1.3*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                    <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="130" />
                    <DataGridTextColumn Header="TLS keys" Binding="{Binding KeylogSize}" Width="95" />
                    <DataGridTextColumn Header="Packets" Binding="{Binding PcapSize}" Width="95" />
                    <DataGridTextColumn Header="" Binding="{Binding Note}" Width="2*" />
                    <DataGridTemplateColumn Header="" Width="290">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,2">
                            <Button Content="Stop" Padding="8,2" FontSize="11"
                                    IsVisible="{Binding IsRunning}"
                                    Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).StopCaptureCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Requests" Padding="8,2" FontSize="11"
                                    IsEnabled="{Binding CanDecode}"
                                    Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).DecodeCaptureCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Decrypts the capture with this session's own TLS keys and lists what the application asked for." />
                            <Button Content="Wireshark" Padding="8,2" FontSize="11"
                                    IsEnabled="{Binding HasPcap}"
                                    Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).OpenInWiresharkCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Opens the capture in Wireshark. The TLS keys are inside the file, so no keylog path needs setting." />
                            <Button Content="Folder" Padding="8,2" FontSize="11"
                                    Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).OpenCaptureFolderCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="8" Background="Transparent"
                              HorizontalAlignment="Stretch" ResizeDirection="Rows"
                              IsVisible="{Binding HasDecoded}" />

                <!-- The summary is not decoration. A capture of a Schannel application
                     decodes to nothing for a completely different reason than one full of
                     QUIC, and an empty list alone cannot tell the two apart. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"
                            Margin="8,2,8,6" IsVisible="{Binding HasDecoded}">
                  <TextBlock Text="{Binding DecodedCapture.DisplayName}" Classes="heading"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DecodeSummary}" Classes="label" TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding Exchanges}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          IsVisible="{Binding Exchanges.Count}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100" />
                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                    <DataGridTemplateColumn Header="URL" Width="3*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <!-- Headers hang off the URL cell as a tooltip: there is no room
                               for them as columns, and they are something a user inspects
                               one request at a time rather than scans down a list. -->
                          <TextBlock Text="{Binding Url}" VerticalAlignment="Center"
                                     Margin="6,0" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Headers}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding ContentType}" Width="1.2*" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="130" />
                    <DataGridTextColumn Header="Took" Binding="{Binding Duration}" Width="90" />
                    <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="80" />
                    <DataGridTextColumn Header="" Binding="{Binding Note}" Width="1.6*" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Settings">
            <!-- Scrolls: the tab shares the window with the app list, so the panel is
                 routinely shorter than its content. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,12" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
              <CheckBox Content="Close to the tray instead of exiting"
                        IsChecked="{Binding MinimiseToTray}" />
              <CheckBox Content="Start Keyhole when I sign in"
                        IsChecked="{Binding StartWithWindows}" />
              <CheckBox Content="Resolve remote addresses to hostnames"
                        IsChecked="{Binding ResolveHostnames}" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Keep flow history for" VerticalAlignment="Center" Classes="label" />
                <NumericUpDown Value="{Binding RetentionDays}" Minimum="1" Maximum="3650"
                               Increment="1" Width="110" FormatString="0" />
                <TextBlock Text="days" VerticalAlignment="Center" Classes="label" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Stop recording packets after" VerticalAlignment="Center"
                           Classes="label" />
                <NumericUpDown Value="{Binding MaxPcapMegabytes}" Minimum="1" Maximum="1048576"
                               Increment="64" Width="130" FormatString="0" />
                <TextBlock Text="MB per session" VerticalAlignment="Center" Classes="label" />
              </StackPanel>

              <TextBlock TextWrapping="Wrap" Classes="label"
                         Text="A browser session can produce hundreds of megabytes in minutes. At the limit the packet recording stops and says so; the session keeps running and keeps collecting TLS keys. Takes effect for captures started after the service restarts." />

              <TextBlock Text="{Binding SettingsMessage}" Classes="label" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningText}"
                         IsVisible="{Binding SettingsMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <TextBlock TextWrapping="Wrap" Classes="label"
                         Text="Flow history, rules and captures live in %ProgramData%\Keyhole. A capture folder holds the recorded packets and the TLS keys that decrypt them, in one place — treat it as sensitive as the traffic itself." />
            </StackPanel>
            </ScrollViewer>
          </TabItem>

        </TabControl>
      </Border>
    </Grid>
  </Grid>
</Window>
