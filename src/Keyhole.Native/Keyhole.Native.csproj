<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Keyhole.Native</RootNamespace>
    <!-- P/Invoke surface for ETW, iphlpapi, Windows Firewall COM and shell icons. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <ItemGroup>
    <!-- Firewall rule naming is internal but load-bearing for reconciliation, so it is
         tested directly rather than only through the public surface. -->
    <InternalsVisibleTo Include="Keyhole.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keyhole.Core\Keyhole.Core.csproj" />
  </ItemGroup>

</Project>
