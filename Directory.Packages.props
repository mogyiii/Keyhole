<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <!-- Avalonia.Diagnostics (DevTools) has no 12.x release yet; add it once it ships. -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- DataGrid trails the core packages by a patch; NuGet resolves its Avalonia
         dependency up to 12.1.4, so this is not a downgrade. -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Hosting and logging">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Monitoring">
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="Packet capture">
    <!-- Npcap itself is not shipped: its free licence forbids redistribution, so Keyhole
         detects it and offers to fetch the vendor's installer. These two are only the
         managed bindings, and both are BSD-licensed. -->
    <PackageVersion Include="SharpPcap" Version="6.3.1" />
    <PackageVersion Include="PacketDotNet" Version="1.4.8" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="GeoIP">
    <!-- The MMDB reader only, Apache-2.0. The database files themselves are not shipped:
         MaxMind requires an account and its licence governs redistribution. Keyhole reads
         whatever the user puts in the geoip folder. -->
    <PackageVersion Include="MaxMind.Db" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
